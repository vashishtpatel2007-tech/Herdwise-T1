# PashuGuard environment
#
# Copy to `.env` and fill in. NEVER commit `.env`. NEVER paste these values
# into a chat window — set them in your local file only.
#
# Anything prefixed VITE_ is bundled into the browser build and is PUBLIC.
# Anything NOT prefixed VITE_ is server-side only and must never reach the client.

# ---- Client-safe (embedded in the browser bundle) -------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server-side ONLY (Edge Functions / scripts) --------------------------
# Bypasses RLS. If this ever appears in a VITE_ variable, treat it as a breach.
SUPABASE_SERVICE_ROLE_KEY=

# TomTom Traffic Flow API. Proxied through the `traffic-refresh` Edge Function
# so the key never reaches the browser. Absent -> engine uses the time-of-day
# fallback model and the UI shows a visible notice (§13.4).
TOMTOM_API_KEY=

# Shared secret collars sign their ingest posts with. The device simulator uses
# the same value so simulated collars are indistinguishable from real ones.
DEVICE_INGEST_SECRET=

# ---- Local tooling -------------------------------------------------------
# Used by scripts/import_roads.ts and scripts/simulate_devices.ts.
# Default points at the local Supabase stack.
SUPABASE_URL=
INGEST_URL=
